{
  "name": "league-helper",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "postinstall": "pnpm --filter @league-helper/shared build && pnpm --filter @league-helper/match-analytics build && pnpm --filter @league-helper/server-riot build",
    "dev": "pnpm -r --parallel --filter @league-helper/web --filter @league-helper/api --filter @league-helper/worker run dev",
    "dev:web": "pnpm --filter @league-helper/web dev",
    "dev:api": "pnpm --filter @league-helper/api dev",
    "dev:worker": "pnpm --filter @league-helper/worker dev",
    "worker:dev": "pnpm dev:worker",
    "worker:smoke": "pnpm --filter @league-helper/worker smoke",
    "build": "pnpm --filter @league-helper/shared build && pnpm --filter @league-helper/match-analytics build && pnpm --filter @league-helper/server-riot build && pnpm --filter @league-helper/api build && pnpm --filter @league-helper/worker build && pnpm --filter @league-helper/web build",
    "lint": "pnpm -r --filter \"@league-helper/*\" run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --filter \"@league-helper/*\" run typecheck",
    "test": "pnpm -r --filter \"@league-helper/*\" run test",
    "db:generate": "pnpm --filter @league-helper/api prisma:generate",
    "db:migrate": "pnpm --filter @league-helper/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @league-helper/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @league-helper/api db:seed",
    "db:studio": "pnpm --filter @league-helper/api prisma:studio",
    "db:test:prepare": "pnpm --filter @league-helper/api db:test:prepare",
    "test:api:integration": "pnpm --filter @league-helper/api test:integration",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "riot:resolve": "pnpm --filter @league-helper/api riot:resolve",
    "riot:match-ids": "pnpm --filter @league-helper/api riot:match-ids",
    "ddragon:champion": "pnpm --filter @league-helper/api ddragon:champion",
    "champions:sync-static": "pnpm --filter @league-helper/api champions:sync-static",
    "jobs:reconcile-match-ingestion": "pnpm --filter @league-helper/api jobs:reconcile-match-ingestion",
    "jobs:status-match-ingestion": "pnpm --filter @league-helper/api jobs:status-match-ingestion",
    "jobs:retry-match-ingestion": "pnpm --filter @league-helper/worker jobs:retry-match-ingestion",
    "aggregates:rebuild-champions": "pnpm --filter @league-helper/worker aggregates:rebuild-champions",
    "aggregates:reconcile-champions": "pnpm --filter @league-helper/worker aggregates:reconcile-champions",
    "aggregates:status-champions": "pnpm --filter @league-helper/worker aggregates:status-champions",
    "aggregates:audit-rank-coverage": "pnpm --filter @league-helper/worker aggregates:audit-rank-coverage",
    "aggregates:audit-champions": "pnpm --filter @league-helper/worker aggregates:audit-champions",
    "aggregates:rank-enrichment-health": "pnpm --filter @league-helper/worker aggregates:rank-enrichment-health",
    "aggregates:backfill-participant-ranks": "pnpm --filter @league-helper/worker aggregates:backfill-participant-ranks",
    "player:search:mock": "pnpm --filter @league-helper/api player:search:mock",
    "matches:bootstrap-player": "pnpm --filter @league-helper/api matches:bootstrap-player",
    "matches:recompute-positions": "pnpm --filter @league-helper/api matches:recompute-positions",
    "collector:seed-player": "pnpm --filter @league-helper/api collector:seed-player",
    "collector:ladder-seed": "pnpm --filter @league-helper/api collector:ladder-seed",
    "collector:set-player-status": "pnpm --filter @league-helper/api collector:set-player-status",
    "collector:run": "pnpm --filter @league-helper/api collector:run",
    "collector:status": "pnpm --filter @league-helper/api collector:status",
    "collector:coverage": "pnpm --filter @league-helper/api collector:coverage",
    "collector:audit": "pnpm --filter @league-helper/api collector:audit",
    "collector:scheduler": "pnpm --filter @league-helper/api collector:scheduler",
    "collector:scheduler-status": "pnpm --filter @league-helper/api collector:scheduler-status",
    "collector:scheduler-trigger": "pnpm --filter @league-helper/api collector:scheduler-trigger",
    "ops:phase5-observation-snapshot": "node --env-file=apps/api/.env apps/api/scripts/phase5-observation-snapshot.mjs",
    "ops:phase6a-db-audit": "node --env-file=apps/api/.env apps/api/scripts/phase6a-db-audit.mjs",
    "ops:phase6b-wave-metrics": "node --env-file=apps/api/.env apps/api/scripts/phase6b-wave-metrics.mjs",
    "test:e2e": "pnpm --filter @league-helper/web test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
