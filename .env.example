# Copy to .env and adjust for local development.
# Never commit real secrets.

# PostgreSQL (docker-compose credentials; M12-v2 clean M11 DB name)
# Keep experimental archive DB `league_helper` untouched; use `league_helper_m12v2` for active work.
# Fresh/migrated DBs have empty ChampionStaticData until you run:
#   pnpm champions:sync-static
DATABASE_URL=postgresql://league:league@localhost:5432/league_helper_m12v2?schema=public
# Separate Prisma schema for destructive/integration tests (same database, different schema)
TEST_DATABASE_URL=postgresql://league:league@localhost:5432/league_helper_m12v2?schema=league_helper_test
# Worker PG integration tests (distinct from API test schema to avoid parallel TRUNCATE races)
WORKER_TEST_DATABASE_URL=postgresql://league:league@localhost:5432/league_helper_m12v2?schema=league_helper_worker_test

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Riot API (backend / worker only — never expose to the browser)
RIOT_API_KEY=your_riot_api_key_here
RIOT_API_TIMEOUT_MS=10000
RIOT_API_MAX_RETRIES=2
RIOT_API_MAX_RETRY_DELAY_MS=5000
RIOT_API_BASE_DOMAIN=api.riotgames.com
RIOT_PROVIDER_MODE=mock

# Data Dragon (public CDN — no API key; server-side only)
DATA_DRAGON_LOCALE=en_US
DATA_DRAGON_CACHE_TTL_SECONDS=21600
DATA_DRAGON_REQUEST_TIMEOUT_MS=10000
DATA_DRAGON_VERSION=latest
DATA_DRAGON_SYNC_MIN_CHAMPIONS=100
DATA_DRAGON_SYNC_MAX_RETRIES=2

# API
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000

# Player search / refresh / match-ingestion queue (backend only — never NUXT_PUBLIC_*)
PLAYER_REFRESH_COOLDOWN_SECONDS=120
PLAYER_PROFILE_CACHE_TTL_SECONDS=60
PLAYER_MASTERY_LIMIT=10
PLAYER_MASTERY_SNAPSHOT_MIN_AGE_SECONDS=3600
PLAYER_DEFAULT_MATCH_COUNT=20
PLAYER_MAX_MATCH_COUNT=100
# Empty = discover recent matches across all queues (omit Riot queue filter).
PLAYER_DEFAULT_MATCH_QUEUE_ID=
# Ranked-only analytics default (not used for general recent-match discovery).
RANKED_SOLO_QUEUE_ID=420
MATCH_INGESTION_QUEUE_NAME=match-ingestion
MATCH_INGESTION_JOB_ATTEMPTS=5
MATCH_INGESTION_RECONCILE_BATCH_SIZE=100
MATCH_INGESTION_WORKER_CONCURRENCY=2
MATCH_INGESTION_BACKOFF_BASE_MS=2000
MATCH_INGESTION_BACKOFF_MAX_MS=60000
# Match-timeline enrichment worker (CLI backfill / retry). Default concurrency 1.
# Search historical enqueue gate is API-only (not a worker ingest flag).
# Riot budget protection; enable later with production capacity.
# Inline eligible ingest still persists product timeline without this flag. CLI backfill independent.
MATCH_TIMELINE_SEARCH_BACKFILL_ENABLED=false
MATCH_TIMELINE_QUEUE_NAME=match-timeline
MATCH_TIMELINE_WORKER_CONCURRENCY=1
MATCH_TIMELINE_JOB_ATTEMPTS=5
MATCH_TIMELINE_BACKOFF_BASE_MS=2000
MATCH_TIMELINE_BACKOFF_MAX_MS=60000
MATCH_TIMELINE_FETCH_ENABLED=true
# Keep false: build/skill path uses MatchTimelineEvent, not full raw JSON retention.
MATCH_STORE_RAW_PAYLOADS=false
MATCH_TIMELINE_REQUIRED_FOR_COMPLETE=false
MATCH_NORMALIZATION_VERSION=1
REFRESH_LOCK_TTL_SECONDS=60

# Ops bootstrap (CLI only — not used by public UI)
MATCH_BOOTSTRAP_DEFAULT_QUEUE_ID=420
MATCH_BOOTSTRAP_DEFAULT_MAX_MATCHES=100
MATCH_BOOTSTRAP_HARD_MAX_MATCHES=500
MATCH_BOOTSTRAP_PAGE_SIZE=100
MATCH_BOOTSTRAP_FILE_MAX_PLAYERS=25
MATCH_BOOTSTRAP_MAX_CONCURRENCY=3
MATCH_BOOTSTRAP_WAIT_TIMEOUT_MS=120000
MATCH_BOOTSTRAP_WAIT_POLL_INTERVAL_MS=2000

# Ops population collector (CLI only — not used by public UI)
COLLECTOR_BATCH_SIZE=10
COLLECTOR_CONCURRENCY=2
COLLECTOR_MATCHES_PER_PLAYER=20
COLLECTOR_MAX_MATCH_IDS_PER_RUN=200
COLLECTOR_MAX_ENQUEUE_PER_RUN=200
# Legacy warm alias when COLLECTOR_WARM_REFRESH_INTERVAL_MS is unset (default 6h).
COLLECTOR_MIN_REFRESH_INTERVAL_MS=21600000
# Milestone 11 Phase 3 activity refresh (success path). Must satisfy HOT < WARM < COLD.
COLLECTOR_HOT_REFRESH_INTERVAL_MS=3600000
COLLECTOR_WARM_REFRESH_INTERVAL_MS=21600000
COLLECTOR_COLD_REFRESH_INTERVAL_MS=172800000
COLLECTOR_COLD_AFTER_ZERO_NEW_RUNS=3
COLLECTOR_MAX_CONSECUTIVE_ZERO_NEW_MATCH_RUNS=100
# Activity priorities: HOT >= WARM >= COLD (absolute tier values, not unbounded increments).
COLLECTOR_HOT_PRIORITY=100
COLLECTOR_WARM_PRIORITY=50
COLLECTOR_COLD_PRIORITY=10
# Fresh enrollment priorities (before first successful refresh). Ladder must be <= product roots.
COLLECTOR_LADDER_INITIAL_PRIORITY=50
COLLECTOR_PRODUCT_ROOT_INITIAL_PRIORITY=100
COLLECTOR_BASE_BACKOFF_MS=900000
COLLECTOR_MAX_BACKOFF_MS=86400000
COLLECTOR_MAX_BACKOFF_EXPONENT=8
COLLECTOR_PLAYER_TIMEOUT_MS=600000
COLLECTOR_LEASE_DURATION_MS=900000
COLLECTOR_STALE_RUN_AFTER_MS=7200000
COLLECTOR_PLATFORM_ALLOWLIST=na1
COLLECTOR_ESTIMATED_REQUESTS_PER_ENQUEUED_MATCH=2
COLLECTOR_PRIORITY_MIN=0
COLLECTOR_PRIORITY_MAX=1000
COLLECTOR_ENROLL_FROM_BOOTSTRAP=false
COLLECTOR_ENROLL_FROM_SEARCH=false

# Task 4 scheduler (dedicated `collector:scheduler` process only — never starts on API boot)
# Default DISABLED. Never auto-starts from API/worker Nest boot. Operator enables via process
# env / real env for observation windows only — agents must not edit real .env files.
COLLECTOR_SCHEDULER_ENABLED=false
COLLECTOR_SCHEDULE_INTERVAL_MS=900000
COLLECTOR_SCHEDULE_BATCH_SIZE=10
COLLECTOR_SCHEDULE_CONCURRENCY=2
COLLECTOR_SCHEDULE_MAX_MATCHES_PER_PLAYER=20
COLLECTOR_SCHEDULE_MAX_MATCH_IDS=200
COLLECTOR_SCHEDULE_MAX_ENQUEUE=200
COLLECTOR_SCHEDULER_LEASE_SAFETY_MARGIN_MS=300000
COLLECTOR_SCHEDULER_LEASE_MS=3600000
# Local scheduler status-mirror cooldown after a rate-limited run (fallback only).
# Must not shorten the shared Riot cooldown below.
COLLECTOR_SCHEDULER_RATE_LIMIT_COOLDOWN_MS=900000
# Shared cross-process Riot 429 cooldown floor (Redis key riot:shared-429-cooldown).
# Authoritative for ladder seed, population collector, scheduler, and match-ingestion worker.
# Product search is intentionally out of Phase 3A.
RIOT_SHARED_429_COOLDOWN_MIN_MS=900000
# Proactive cross-process Riot request budget (Redis). Complements shared 429 cooldown.
# Developer-key defaults leave ~25% headroom (utilization 0.75) for PRODUCT_SEARCH / variance.
# Operators apply to real env — agents must not edit real .env files.
RIOT_REQUEST_BUDGET_ENABLED=true
RIOT_REQUEST_BUDGET_UTILIZATION=0.75
RIOT_REQUEST_BUDGET_SHORT_LIMIT=20
RIOT_REQUEST_BUDGET_SHORT_WINDOW_SECONDS=1
RIOT_REQUEST_BUDGET_LONG_LIMIT=100
RIOT_REQUEST_BUDGET_LONG_WINDOW_SECONDS=120
RIOT_REQUEST_BUDGET_ENRICHMENT_MAX_SHARE=0.35
RIOT_REQUEST_BUDGET_PRODUCT_RESERVED_SHARE=0.10
RIOT_REQUEST_BUDGET_MAX_INLINE_WAIT_MS=2000
RIOT_REQUEST_BUDGET_OBSERVE_HEADERS=true
# Collector paced-refresh pressure heuristic (NOT Riot admission).
# Soft long = floor(RIOT_REQUEST_BUDGET_LONG_LIMIT * UTILIZATION) - SOFT_LONG_SAFETY_MARGIN
# (default 100*0.75 - 4 = 71). Hard long is a queue/pressure heuristic above the util ceiling.
# Long soft waits also require enrichment backlog (LONG_SOFT_MIN_ENRICH_PENDING); enrichPending=0
# does not idle solely on long-window pressure. RiotRequestBudgetStore remains authoritative.
COLLECTOR_RIOT_PRESSURE_SOFT_LONG_SAFETY_MARGIN=4
COLLECTOR_RIOT_PRESSURE_HARD_LONG_WINDOW=85
COLLECTOR_RIOT_PRESSURE_SOFT_ENRICH_PENDING=40
COLLECTOR_RIOT_PRESSURE_HARD_ENRICH_PENDING=120
COLLECTOR_RIOT_PRESSURE_LONG_SOFT_MIN_ENRICH_PENDING=1
COLLECTOR_RIOT_PRESSURE_SOFT_WAIT_MS=15000
COLLECTOR_RIOT_PRESSURE_HARD_WAIT_MS=25000
COLLECTOR_RIOT_PRESSURE_COOLDOWN_WAIT_MS=20000
COLLECTOR_MAX_PENDING_INGESTION_JOBS=500
COLLECTOR_SCHEDULE_QUEUE_ID=420
# COLLECTOR_SCHEDULE_PLATFORM=

# -----------------------------------------------------------------------------
# M12-v2 Phase 5 — observation-scale continuous ops (example profile ONLY)
# Apply as one-shot process env overrides for `collector:scheduler-trigger` /
# `collector:scheduler`. Do NOT raise caps or enable ladder/expansion here.
# Recommended developer-key observation window:
#   COLLECTOR_SCHEDULER_ENABLED=true
#   COLLECTOR_SCHEDULE_INTERVAL_MS=120000
#   COLLECTOR_SCHEDULE_BATCH_SIZE=2
#   COLLECTOR_SCHEDULE_CONCURRENCY=1
#   COLLECTOR_SCHEDULE_MAX_MATCHES_PER_PLAYER=5
#   COLLECTOR_SCHEDULE_MAX_MATCH_IDS=20
#   COLLECTOR_SCHEDULE_MAX_ENQUEUE=20
#   COLLECTOR_MAX_PENDING_INGESTION_JOBS=50
#   COLLECTOR_EXPAND_FROM_PARTICIPANTS=false
#   COLLECTOR_ENROLL_FROM_SEARCH=true   # only for tiny PRODUCT_SEARCH validation
# Optional short HOT/WARM/COLD for multi-tick observation (must keep HOT < WARM < COLD):
#   COLLECTOR_HOT_REFRESH_INTERVAL_MS=60000
#   COLLECTOR_WARM_REFRESH_INTERVAL_MS=120000
#   COLLECTOR_COLD_REFRESH_INTERVAL_MS=300000
# Worker observation concurrency (apps/worker/.env.example):
#   MATCH_INGESTION_WORKER_CONCURRENCY=1
#   PARTICIPANT_RANK_ENRICHMENT_WORKER_CONCURRENCY=1
#   CHAMPION_AGGREGATION_WORKER_CONCURRENCY=1
# Snapshot helper:
#   node --env-file=apps/api/.env apps/api/scripts/phase5-observation-snapshot.mjs
# -----------------------------------------------------------------------------

# Task 4 participant expansion (worker; disabled by default)
COLLECTOR_EXPAND_FROM_PARTICIPANTS=false
COLLECTOR_EXPANSION_MAX_DEPTH=1
COLLECTOR_EXPANSION_MAX_NEW_PLAYERS_PER_MATCH=3
COLLECTOR_EXPANSION_MAX_NEW_PLAYERS_PER_SOURCE_PLAYER=5
COLLECTOR_EXPANSION_MAX_NEW_PLAYERS_PER_RUN=20
COLLECTOR_EXPANSION_MAX_TRACKED_PLAYERS=500
COLLECTOR_EXPANSION_QUEUE_ID=420

# Milestone 11 ladder enrollment (CLI seeder; safety caps fail-fast above hard max)
# Global TrackedPlayer ceiling (all enrollmentSource values). Hard max 50000.
COLLECTOR_TOTAL_TRACKED_PLAYERS_HARD_CAP=5000
# LADDER-source TrackedPlayer ceiling. Hard max 20000; must be <= total hard cap.
COLLECTOR_LADDER_MAX_TOTAL=3000
# In-memory per-run create ceiling (NOT a DB counter). Hard max 1000; must be <= ladder max total.
COLLECTOR_LADDER_MAX_NEW_PER_RUN=100
# Ranked Solo only for M11.
COLLECTOR_LADDER_QUEUE_TYPE=RANKED_SOLO_5x5
# Apex tiers (A1). Allowlist: CHALLENGER,GRANDMASTER,MASTER (shared RANK_SEGMENTS.APEX).
# Default omits MASTER (large league list). Include MASTER only for explicit Apex repair / 6B+.
# Ladder-seed CLI still requires MASTER to appear in --tiers (not config defaults alone).
COLLECTOR_LADDER_TIERS=CHALLENGER,GRANDMASTER
# Representative tiers (A2). Allowlist: DIAMOND,EMERALD,PLATINUM,GOLD,SILVER,BRONZE,IRON
# Default stays High+Mid; low tiers are opt-in for Phase 6E via env or ladder-seed --tiers.
COLLECTOR_LADDER_REPRESENTATIVE_TIERS=DIAMOND,EMERALD,PLATINUM,GOLD
# Pages per tier/division for A2. Hard max 5.
COLLECTOR_LADDER_MAX_PAGES_PER_TIER_DIVISION=1
# Scan ceiling while iterating ladder pages (not a create cap). Hard max 5000.
COLLECTOR_LADDER_MAX_CANDIDATES_SCANNED=500
# Optional single-platform filter; must be in COLLECTOR_PLATFORM_ALLOWLIST when set.
# COLLECTOR_LADDER_PLATFORM=

# Env-guard for `pnpm jobs:retry-match-ingestion` (must be YES to run)
# RETRY_MATCH_INGESTION_CONFIRM=YES
# RETRY_MATCH_INGESTION_LIMIT=50
# RETRY_MATCH_INGESTION_IDS=

# Champion aggregation (worker process + CLIs; versions must stay aligned with API)
CHAMPION_AGGREGATION_QUEUE_NAME=champion-aggregation
CHAMPION_AGGREGATION_WORKER_CONCURRENCY=2
CHAMPION_AGGREGATION_JOB_ATTEMPTS=5
CHAMPION_AGGREGATION_VERSION=2
CHAMPION_AGGREGATION_SOURCE_NORMALIZATION_VERSION=1
CHAMPION_AGGREGATION_CONFIDENCE_LEVEL=0.95
CHAMPION_AGGREGATION_BATCH_SIZE=50
CHAMPION_AGGREGATION_MIN_SAMPLE=30
CHAMPION_AGGREGATION_DEFAULT_QUEUE_ID=420
# Optional build-aggregate version (API reads + rebuild CLI). Distinct cache prefix from champ_stats.
CHAMPION_BUILD_AGGREGATION_VERSION=1
CHAMPION_MATCHUP_AGGREGATION_VERSION=1
CHAMPION_MATCHUP_DISPLAY_FLOOR=10
# Env-guard for `pnpm aggregates:rebuild-champions` mutating apply (must be YES, or pass --confirm)
# AGGREGATES_REBUILD_CHAMPIONS_CONFIRM=YES
# Env-guard for `pnpm aggregates:rebuild-champion-builds` mutating apply (must be YES, or pass --confirm)
# AGGREGATES_REBUILD_BUILDS_CONFIRM=YES
# Env-guard for `pnpm aggregates:rebuild-champion-matchups` mutating apply (must be YES, or pass --confirm)
# AGGREGATES_REBUILD_MATCHUPS_CONFIRM=YES

# M12-v2 participant-rank enrichment (worker; operator applies to real env — agents must not)
PARTICIPANT_RANK_ENRICHMENT_QUEUE_NAME=participant-rank-enrichment
PARTICIPANT_RANK_ENRICHMENT_WORKER_CONCURRENCY=1
PARTICIPANT_RANK_ENRICHMENT_JOB_ATTEMPTS=5
PARTICIPANT_RANK_ENRICHMENT_BACKOFF_BASE_MS=2000
PARTICIPANT_RANK_ENRICHMENT_BACKOFF_MAX_MS=60000
PARTICIPANT_RANK_OBSERVATION_FRESHNESS_MS=21600000
# Phase 4 bounded backfill CLI defaults (flags override; mutating run needs --confirm)
# PARTICIPANT_RANK_BACKFILL_MAX_PARTICIPANTS=200
# PARTICIPANT_RANK_BACKFILL_MAX_RIOT_CALLS=100

# Champion stats API (read path; versions must stay aligned with worker aggregation)
CHAMPION_STATS_DEFAULT_PLATFORM=na1
CHAMPION_STATS_CACHE_TTL_SECONDS=60


# Nuxt public runtime (safe for browser — API base only; never put RIOT_API_KEY here)
NUXT_PUBLIC_API_BASE=http://localhost:3001

# -----------------------------------------------------------------------------
# M16 Champion AI + M17 Player playstyle AI (off by default; never commit real keys)
# Local Ollama:
#   ollama pull qwen2.5:14b
#   ollama serve
# Then set AI_ENABLED=true in apps/api/.env and apps/worker/.env (never commit real keys).
# Shared AI_MODEL default is qwen2.5:14b (still overridable). Keep both AI worker
# concurrencies at 1 when sharing a local GPU.
# Leave AI_API_KEY empty for local Ollama. Do not use NUXT_PUBLIC_* for any AI secret.
# After CHAMPION_AGGREGATION_VERSION=2 (gold/min), rebuild:
#   pnpm aggregates:rebuild-champions --confirm
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:14b
AI_API_KEY=
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.2
AI_MAX_REPAIR_ATTEMPTS=1
CHAMPION_AI_INSIGHT_QUEUE_NAME=champion-ai-insight
CHAMPION_AI_INSIGHT_JOB_ATTEMPTS=3
PLAYER_AI_PLAYSTYLE_QUEUE_NAME=player-ai-playstyle
PLAYER_AI_PLAYSTYLE_JOB_ATTEMPTS=3
