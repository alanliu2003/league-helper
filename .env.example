# Copy to .env and adjust for local development.
# Never commit real secrets.

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://league:league@localhost:5432/league_helper?schema=public

# Separate Prisma schema for destructive/integration tests (same database, different schema)
TEST_DATABASE_URL=postgresql://league:league@localhost:5432/league_helper?schema=league_helper_test

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Riot API (backend / worker only — never expose to the browser)
RIOT_API_KEY=your_riot_api_key_here
RIOT_API_TIMEOUT_MS=10000
RIOT_API_MAX_RETRIES=2
RIOT_API_MAX_RETRY_DELAY_MS=5000
RIOT_API_BASE_DOMAIN=api.riotgames.com
RIOT_PROVIDER_MODE=mock

# API
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000

# Player search / refresh / match-ingestion queue (backend only — never NUXT_PUBLIC_*)
PLAYER_REFRESH_COOLDOWN_SECONDS=120
PLAYER_PROFILE_CACHE_TTL_SECONDS=60
PLAYER_MASTERY_LIMIT=10
PLAYER_MASTERY_SNAPSHOT_MIN_AGE_SECONDS=3600
PLAYER_DEFAULT_MATCH_COUNT=20
PLAYER_MAX_MATCH_COUNT=100
PLAYER_DEFAULT_QUEUE_ID=420
MATCH_INGESTION_QUEUE_NAME=match-ingestion
MATCH_INGESTION_JOB_ATTEMPTS=5
MATCH_INGESTION_RECONCILE_BATCH_SIZE=100
REFRESH_LOCK_TTL_SECONDS=60

# Nuxt public runtime (safe for browser — API base only; never put RIOT_API_KEY here)
NUXT_PUBLIC_API_BASE=http://localhost:3001
