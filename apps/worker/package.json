{
  "name": "@league-helper/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "smoke": "tsx src/cli/smoke-worker.ts",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:test:prepare": "node ./scripts/prepare-test-db.mjs",
    "test": "pnpm db:test:prepare && vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema ../api/prisma/schema.prisma",
    "jobs:retry-match-ingestion": "tsx src/cli/retry-match-ingestion.ts",
    "jobs:backfill-match-timeline": "tsx src/cli/backfill-match-timeline.ts",
    "aggregates:rebuild-champions": "tsx src/cli/rebuild-champion-aggregates.ts",
    "aggregates:rebuild-champion-builds": "tsx src/cli/rebuild-champion-builds.ts",
    "aggregates:rebuild-champion-matchups": "tsx src/cli/rebuild-champion-matchups.ts",
    "aggregates:reconcile-champions": "tsx src/cli/reconcile-champion-aggregates.ts",
    "aggregates:status-champions": "tsx src/cli/status-champion-aggregates.ts",
    "aggregates:audit-rank-coverage": "tsx src/cli/audit-rank-coverage.ts",
    "aggregates:audit-champions": "tsx src/cli/audit-champions.ts",
    "aggregates:rank-enrichment-health": "tsx src/cli/rank-enrichment-health.ts",
    "aggregates:backfill-participant-ranks": "tsx src/cli/backfill-participant-ranks.ts"
  },
  "dependencies": {
    "@league-helper/ai": "workspace:*",
    "@league-helper/match-analytics": "workspace:*",
    "@league-helper/server-riot": "workspace:*",
    "@league-helper/shared": "workspace:*",
    "@prisma/client": "^6.5.0",
    "bullmq": "^5.81.3",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@league-helper/config": "workspace:*",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
