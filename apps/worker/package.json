{
  "name": "@league-helper/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@league-helper/shared": "workspace:*",
    "bullmq": "^5.44.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@league-helper/config": "workspace:*",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
