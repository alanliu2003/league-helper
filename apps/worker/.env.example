REDIS_URL=redis://localhost:6379

# Required for match-ingestion persistence (Prisma). Generate client with:
#   pnpm --filter @league-helper/worker prisma:generate
# or root `pnpm db:generate` (uses apps/api/prisma/schema.prisma).
# M12-v2 clean M11 DB. Leave archive DB `league_helper` untouched.
DATABASE_URL=postgresql://league:league@localhost:5432/league_helper_m12v2?schema=public
# Worker PG integration tests (must differ from API TEST_DATABASE_URL / league_helper_test)
WORKER_TEST_DATABASE_URL=postgresql://league:league@localhost:5432/league_helper_m12v2?schema=league_helper_worker_test

RIOT_API_KEY=your_riot_api_key_here
RIOT_API_TIMEOUT_MS=10000
RIOT_API_MAX_RETRIES=2
RIOT_API_MAX_RETRY_DELAY_MS=5000
RIOT_API_BASE_DOMAIN=api.riotgames.com
RIOT_PROVIDER_MODE=mock

# Match-ingestion worker
MATCH_INGESTION_QUEUE_NAME=match-ingestion
# Default 2. M12-v2 Phase 5 observation-scale: prefer 1 on developer key.
MATCH_INGESTION_WORKER_CONCURRENCY=2
MATCH_INGESTION_JOB_ATTEMPTS=5
MATCH_INGESTION_BACKOFF_BASE_MS=2000
MATCH_INGESTION_BACKOFF_MAX_MS=60000
# Shared cross-process Riot 429 cooldown floor (Redis key riot:shared-429-cooldown).
# Coordinates with API ladder/collector/scheduler. Product search left out of Phase 3A.
RIOT_SHARED_429_COOLDOWN_MIN_MS=900000
# Proactive cross-process Riot request budget (Redis). Complements shared 429 cooldown.
# Developer-key defaults leave ~25% headroom (utilization 0.75) for PRODUCT_SEARCH / variance.
RIOT_REQUEST_BUDGET_ENABLED=true
RIOT_REQUEST_BUDGET_UTILIZATION=0.75
RIOT_REQUEST_BUDGET_SHORT_LIMIT=20
RIOT_REQUEST_BUDGET_SHORT_WINDOW_SECONDS=1
RIOT_REQUEST_BUDGET_LONG_LIMIT=100
RIOT_REQUEST_BUDGET_LONG_WINDOW_SECONDS=120
RIOT_REQUEST_BUDGET_ENRICHMENT_MAX_SHARE=0.35
RIOT_REQUEST_BUDGET_PRODUCT_RESERVED_SHARE=0.10
RIOT_REQUEST_BUDGET_MAX_INLINE_WAIT_MS=2000
RIOT_REQUEST_BUDGET_OBSERVE_HEADERS=true
# Collector pressure knobs live in API/.env.example (paced refresh heuristic only).
# Worker continues to honor RiotRequestBudgetStore + shared 429 cooldown only.
MATCH_TIMELINE_FETCH_ENABLED=true
# Keep false: build/skill path uses MatchTimelineEvent, not full raw JSON retention.
MATCH_STORE_RAW_PAYLOADS=false
MATCH_TIMELINE_REQUIRED_FOR_COMPLETE=false
MATCH_NORMALIZATION_VERSION=1

# Task 4 participant expansion (disabled by default; loaded per expansion-hook invocation)
COLLECTOR_EXPAND_FROM_PARTICIPANTS=false
COLLECTOR_EXPANSION_MAX_DEPTH=1
COLLECTOR_EXPANSION_MAX_NEW_PLAYERS_PER_MATCH=3
COLLECTOR_EXPANSION_MAX_NEW_PLAYERS_PER_SOURCE_PLAYER=5
COLLECTOR_EXPANSION_MAX_NEW_PLAYERS_PER_RUN=20
COLLECTOR_EXPANSION_MAX_TRACKED_PLAYERS=500
COLLECTOR_EXPANSION_QUEUE_ID=420
COLLECTOR_PLATFORM_ALLOWLIST=na1

# Champion aggregation worker (no Riot / Data Dragon calls)
# Keep VERSION + SOURCE_NORMALIZATION_VERSION aligned with apps/api
CHAMPION_AGGREGATION_QUEUE_NAME=champion-aggregation
# Default 2. M12-v2 Phase 5 observation-scale: prefer 1 on developer key.
CHAMPION_AGGREGATION_WORKER_CONCURRENCY=2
CHAMPION_AGGREGATION_JOB_ATTEMPTS=5
CHAMPION_AGGREGATION_SOURCE_NORMALIZATION_VERSION=1
CHAMPION_AGGREGATION_VERSION=2
CHAMPION_AGGREGATION_CONFIDENCE_LEVEL=0.95
CHAMPION_AGGREGATION_BATCH_SIZE=50
CHAMPION_AGGREGATION_MIN_SAMPLE=30
CHAMPION_BUILD_AGGREGATION_VERSION=1
CHAMPION_MATCHUP_AGGREGATION_VERSION=1
# Job retention (used at enqueue time):
# removeOnComplete: { age: 3600, count: 1000 }
# removeOnFail: { age: 86400, count: 5000 }

# M12-v2 participant-rank enrichment (Phase 3)
# Operator applies these to real apps/worker/.env — agents must not edit real env.
PARTICIPANT_RANK_ENRICHMENT_QUEUE_NAME=participant-rank-enrichment
# Developer-key default concurrency = 1 (keep bounded).
PARTICIPANT_RANK_ENRICHMENT_WORKER_CONCURRENCY=1
PARTICIPANT_RANK_ENRICHMENT_JOB_ATTEMPTS=5
PARTICIPANT_RANK_ENRICHMENT_BACKOFF_BASE_MS=2000
PARTICIPANT_RANK_ENRICHMENT_BACKOFF_MAX_MS=60000
# Fresh observation reuse window (default 6h). FAILED_RETRYABLE is never a durable cache hit.
PARTICIPANT_RANK_OBSERVATION_FRESHNESS_MS=21600000
# Must check RiotSharedCooldownStore before any League-v4 by-PUUID call (uses RIOT_SHARED_429_COOLDOWN_MIN_MS).

# M12-v2 Phase 4 bounded backfill CLI (pnpm aggregates:backfill-participant-ranks)
# Developer-key defaults are conservative; CLI flags override. Mutating run requires --confirm.
# PARTICIPANT_RANK_BACKFILL_MAX_PARTICIPANTS=200
# PARTICIPANT_RANK_BACKFILL_MAX_RIOT_CALLS=100
# Do not raise these into the thousands on a developer key without an explicit ops decision.

# Env-guard for `pnpm jobs:retry-match-ingestion` (must be YES to run)
# RETRY_MATCH_INGESTION_CONFIRM=YES
# RETRY_MATCH_INGESTION_LIMIT=50
# RETRY_MATCH_INGESTION_IDS=

# Env-guard for `pnpm aggregates:rebuild-champions` mutating apply (must be YES, or pass --confirm)
# AGGREGATES_REBUILD_CHAMPIONS_CONFIRM=YES
# Env-guard for `pnpm aggregates:rebuild-champion-builds` (must be YES, or pass --confirm)
# AGGREGATES_REBUILD_BUILDS_CONFIRM=YES

# -----------------------------------------------------------------------------
# M16 Champion AI Insights (off by default; never commit real keys)
# Local Ollama:
#   ollama pull qwen2.5:7b
#   ollama serve
# Then set AI_ENABLED=true in apps/api/.env and apps/worker/.env (never commit real keys).
# Optional local upgrade: AI_MODEL=qwen2.5:14b
# Leave AI_API_KEY empty for local Ollama. Do not use NUXT_PUBLIC_* for any AI secret.
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:7b
AI_API_KEY=
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.2
AI_MAX_REPAIR_ATTEMPTS=1
CHAMPION_AI_INSIGHT_QUEUE_NAME=champion-ai-insight
CHAMPION_AI_INSIGHT_WORKER_CONCURRENCY=1
CHAMPION_AI_INSIGHT_JOB_ATTEMPTS=3
