{
  "extends": "@league-helper/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "app.vue",
    "pages/**/*",
    "components/**/*",
    "composables/**/*",
    "utils/**/*",
    "nuxt.config.ts",
    ".nuxt/nuxt.d.ts"
  ],
  "exclude": ["node_modules", ".output", "dist"]
}
