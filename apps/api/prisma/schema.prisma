generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Internal status enums (application states — not Riot routing values)
// ---------------------------------------------------------------------------

enum MatchIngestionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum TimelineFetchStatus {
  PENDING
  FETCHED
  FAILED
  SKIPPED
}

enum StaticDataStatus {
  PENDING
  READY
  FAILED
  STALE
}

enum AnalysisReportStatus {
  PENDING
  READY
  FAILED
  EXPIRED
}

/// DB row status: PENDING|READY|FAILED. Distinct from shared public API ChampionAiInsightStatus
/// (DISABLED|PENDING|AVAILABLE|UNAVAILABLE|LOW_CONFIDENCE). Import Prisma as ChampionAiInsightRowStatus.
enum ChampionAiInsightStatus {
  PENDING
  READY
  FAILED
}

/// DB row status: PENDING|READY|FAILED. Distinct from public PlayerAiInsightStatus
/// (DISABLED|PENDING|AVAILABLE|UNAVAILABLE|LOW_CONFIDENCE).
enum PlayerPlaystyleInsightStatus {
  PENDING
  READY
  FAILED
}

enum AnalysisReportType {
  PLAYER_OVERVIEW
  CHAMPION_FOCUS
  MATCHUP_FOCUS
}

enum IngestionJobStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  DEAD_LETTERED
  CANCELLED
}

/// Operational reconcile marker for per-match champion aggregation.
/// COMPLETED | FAILED only — in-progress work is not durably marked here.
enum ChampionAggregationProcessingStatus {
  COMPLETED
  FAILED
}

enum TrackedPlayerStatus {
  ACTIVE
  PAUSED
  SUSPENDED
}

enum TrackedPlayerEnrollmentSource {
  ADMIN_SEED
  PRODUCT_SEARCH
  BOOTSTRAP
  MATCH_PARTICIPANT
  LADDER
}

/// Participant Solo/Flex rank resolution lifecycle (M12-v2).
/// PENDING/FAILED_RETRYABLE never map silently to aggregate UNKNOWN.
enum ParticipantRankResolutionStatus {
  PENDING
  FAILED_RETRYABLE
  RESOLVED_RANKED
  RESOLVED_UNRANKED
  /// Documented permanent-unavailable (e.g. missing PUUID).
  FAILED_PERMANENT
  /// Non-ranked queue — no applicable Solo/Flex rank.
  NOT_APPLICABLE
}

enum CollectorRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

/// Persisted scheduler tick outcomes only. SKIPPED_DISABLED / SKIPPED_OVERLAP are local-only.
enum CollectorSchedulerOutcome {
  TRIGGERED
  SKIPPED_BACKPRESSURE
  SKIPPED_COOLDOWN
  FAILED_TO_START
}

// ---------------------------------------------------------------------------
// Players / accounts
// ---------------------------------------------------------------------------

model Player {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accounts PlayerAccount[]
}

/// Provider account attached to an internal Player.
/// For Riot, externalAccountId is the PUUID (persistent external identity).
/// Riot ID fields are display/lookup only — never used as the permanent identity.
model PlayerAccount {
  id                 String    @id @default(uuid())
  playerId           String
  /// Shared-domain ProviderId value (e.g. "RIOT"), stored as string for forward compatibility.
  provider           String
  /// Persistent external identity (Riot: PUUID).
  externalAccountId  String
  /// Shared-domain PlatformRoute value.
  platformRoute      String
  /// Shared-domain RegionalRoute value.
  regionalRoute      String
  summonerId         String?
  accountId          String?
  currentGameName    String
  currentTagLine     String
  normalizedGameName String
  normalizedTagLine  String
  profileIconId      Int?
  summonerLevel      Int?
  lastResolvedAt     DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  player                Player                    @relation(fields: [playerId], references: [id], onDelete: Restrict)
  aliases               PlayerAccountAlias[]
  rankSnapshots         RankSnapshot[]
  masterySnapshots      ChampionMasterySnapshot[]
  matchParticipants     MatchParticipant[]
  playerMetricSnapshots   PlayerMetricSnapshot[]
  playerAnalysisReports   PlayerAnalysisReport[]
  playerPlaystyleInsights PlayerPlaystyleInsight[]
  trackedPlayer           TrackedPlayer?

  @@unique([provider, externalAccountId])
  @@index([playerId])
  @@index([provider, platformRoute, normalizedGameName, normalizedTagLine])
}

/// Historical Riot ID aliases for a player account.
model PlayerAccountAlias {
  id                 String   @id @default(uuid())
  playerAccountId    String
  gameName           String
  tagLine            String
  normalizedGameName String
  normalizedTagLine  String
  firstSeenAt        DateTime @db.Timestamptz(3)
  lastSeenAt         DateTime @db.Timestamptz(3)
  isCurrent          Boolean  @default(false)

  playerAccount PlayerAccount @relation(fields: [playerAccountId], references: [id], onDelete: Cascade)

  @@index([playerAccountId, isCurrent])
  @@index([normalizedGameName, normalizedTagLine])
}

model RankSnapshot {
  id              String   @id @default(uuid())
  playerAccountId String
  /// Shared-domain QueueType value.
  queueType       String
  /// Shared-domain RankTier value.
  tier            String
  /// Shared-domain RankDivision value, or null for Master+.
  division        String?
  leaguePoints    Int
  wins            Int
  losses          Int
  veteran         Boolean  @default(false)
  inactive        Boolean  @default(false)
  freshBlood      Boolean  @default(false)
  hotStreak       Boolean  @default(false)
  capturedAt      DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  playerAccount PlayerAccount @relation(fields: [playerAccountId], references: [id], onDelete: Cascade)

  @@index([playerAccountId, queueType, capturedAt])
}

// ---------------------------------------------------------------------------
// Matches
// ---------------------------------------------------------------------------

model Match {
  id                   String               @id @default(uuid())
  provider             String
  externalMatchId      String
  platformRoute        String?
  regionalRoute        String
  gameId               BigInt?
  queueId              Int
  mapId                Int?
  gameMode             String?
  gameType             String?
  gameCreation         DateTime             @db.Timestamptz(3)
  gameEndTimestamp     DateTime?            @db.Timestamptz(3)
  gameDurationSeconds  Int
  gameVersion          String
  /// Nullable — not every Riot version string normalizes cleanly.
  normalizedPatch      String?
  remake               Boolean              @default(false)
  earlySurrender       Boolean              @default(false)
  ingestionStatus      MatchIngestionStatus @default(PENDING)
  normalizationVersion String               @default("1")
  /// Denormalized raw response retained for reprocessing; may be large.
  rawPayload           Json?
  ingestedAt           DateTime?            @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)

  participants                  MatchParticipant[]
  teams                         MatchTeam[]
  timeline                      MatchTimeline?
  /// Compact build/skill timeline events (not full Riot timeline frames).
  timelineEvents                MatchTimelineEvent[]
  championAggregationProcessing ChampionAggregationProcessing[]
  championAggregationRecalcScopes ChampionAggregationRecalcScope[]

  @@unique([provider, externalMatchId])
  @@index([normalizedPatch, queueId])
  @@index([gameCreation])
  @@index([ingestionStatus])
  @@index([platformRoute, queueId, gameCreation])
  @@index([regionalRoute, queueId, gameCreation])
}

model MatchParticipant {
  id                             String   @id @default(uuid())
  matchId                        String
  participantId                  Int
  /// SetNull on account delete so historical matches survive.
  playerAccountId                String?
  externalAccountId              String?
  riotIdGameName                 String?
  riotIdTagLine                  String?
  championId                     Int
  championName                   String?
  teamId                         Int
  /// Raw Riot teamPosition (TOP/JUNGLE/MIDDLE/BOTTOM/UTILITY/NONE/INVALID).
  /// Public display uses normalizeParticipantPosition() — do not treat `role` as position.
  teamPosition                   String
  /// Raw Riot individualPosition (preserved for reprocessing).
  individualPosition             String
  /// Raw Riot lane (TOP/MIDDLE/BOTTOM/JUNGLE/NONE) — fallback only when positions missing.
  lane                           String?
  /// Raw Riot legacy role (SOLO/DUO/DUO_CARRY/DUO_SUPPORT) — not a public position.
  role                           String?
  /// Rank observed during ingestion/enrichment cycle — NOT exact match-start rank.
  rankTierAtIngestion            String?
  rankDivisionAtIngestion        String?
  /// Explicit resolution lifecycle; null must not be overloaded for multiple meanings.
  rankResolutionStatus           ParticipantRankResolutionStatus @default(PENDING)
  /// When status last reached a terminal or updated resolved observation.
  rankResolvedAt                 DateTime?                       @db.Timestamptz(3)
  /// Optional link to the ParticipantRankObservation that last updated resolution.
  rankObservationId              String?
  win                            Boolean
  kills                          Int
  deaths                         Int
  assists                        Int
  largestKillingSpree            Int?
  totalMinionsKilled             Int      @default(0)
  neutralMinionsKilled           Int      @default(0)
  totalCs                        Int      @default(0)
  goldEarned                     Int      @default(0)
  goldSpent                      Int      @default(0)
  totalDamageDealtToChampions    Int      @default(0)
  physicalDamageDealtToChampions Int      @default(0)
  magicDamageDealtToChampions    Int      @default(0)
  trueDamageDealtToChampions     Int      @default(0)
  totalDamageTaken               Int      @default(0)
  visionScore                    Int      @default(0)
  wardsPlaced                    Int      @default(0)
  wardsKilled                    Int      @default(0)
  controlWardsPurchased          Int?
  timePlayedSeconds              Int      @default(0)
  /// Final inventory item0–item6; empty slots stored as 0 for new ingestions.
  itemIds                        Int[]    @default([])
  perkIds                        Int[]    @default([])
  statPerkIds                    Int[]    @default([])
  /// Riot perk style tree IDs (e.g. 8000 Precision); null on historical rows.
  primaryPerkStyleId             Int?
  secondaryPerkStyleId           Int?
  summonerSpell1Id               Int      @default(0)
  summonerSpell2Id               Int      @default(0)
  goldAt10                       Int?
  goldAt15                       Int?
  csAt10                         Int?
  csAt15                         Int?
  xpAt10                         Int?
  xpAt15                         Int?
  goldDifferenceAt10             Int?
  goldDifferenceAt15             Int?
  csDifferenceAt10               Int?
  csDifferenceAt15               Int?
  xpDifferenceAt10               Int?
  xpDifferenceAt15               Int?
  deathsBefore10                 Int?
  deathsBetween10And20           Int?
  deathsBeforeObjectives         Int?
  firstCompletedItemId           Int?
  firstCompletedItemAtSeconds    Int?
  killParticipation              Float?
  skillOrder                     Int[]    @default([])
  rawPayload                     Json?
  createdAt                      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime @updatedAt @db.Timestamptz(3)

  match            Match                           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerAccount    PlayerAccount?                  @relation(fields: [playerAccountId], references: [id], onDelete: SetNull)
  rankObservation  ParticipantRankObservation?     @relation(fields: [rankObservationId], references: [id], onDelete: SetNull)

  @@unique([matchId, participantId])
  @@index([matchId, teamId])
  @@index([playerAccountId, matchId])
  @@index([externalAccountId])
  @@index([championId, teamPosition])
  @@index([championId, individualPosition])
  @@index([championId, matchId])
  @@index([rankTierAtIngestion, championId])
  @@index([rankResolutionStatus, championId])
  @@index([rankObservationId])
}

/// Durable League-v4 (or local) participant-rank observations.
/// Identity is provider + platform + PUUID + queueType — no TrackedPlayer/PlayerAccount FK.
model ParticipantRankObservation {
  id                String                           @id @default(uuid())
  provider          String
  platformRoute     String
  /// Riot PUUID (MatchParticipant.externalAccountId).
  externalAccountId String
  /// Shared-domain QueueType (RANKED_SOLO_5x5 / RANKED_FLEX_SR).
  queueType         String
  /// Shared-domain RankTier when resolutionStatus = RESOLVED_RANKED.
  observedTier      String?
  /// Shared-domain RankDivision when applicable (null for Master+).
  observedDivision  String?
  resolutionStatus  ParticipantRankResolutionStatus
  /// Observation time (not globally unique — history is append-only).
  observedAt        DateTime                         @db.Timestamptz(3)
  /// Optional non-secret provider result detail (e.g. HTTP status / empty-entry).
  providerResultCode String?
  createdAt         DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                         @updatedAt @db.Timestamptz(3)

  matchParticipants MatchParticipant[]

  @@index([provider, platformRoute, externalAccountId, queueType, observedAt(sort: Desc)])
  @@index([externalAccountId, queueType, observedAt])
  @@index([resolutionStatus, observedAt])
}

model MatchTeam {
  id             String   @id @default(uuid())
  matchId        String
  teamId         Int
  win            Boolean
  earlySurrender Boolean  @default(false)
  bans           Int[]    @default([])
  /// Variable objective payload from Riot match data.
  objectives     Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamId])
}

model MatchTimeline {
  id                    String              @id @default(uuid())
  matchId               String              @unique
  fetchStatus           TimelineFetchStatus @default(PENDING)
  rawPayload            Json?
  timelineSchemaVersion String              @default("1")
  fetchedAt             DateTime?           @db.Timestamptz(3)
  failureReason         String?
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([fetchStatus])
}

/// Build/skill-relevant Match-v5 timeline events only (ITEM_*, SKILL_LEVEL_UP).
/// Join to MatchParticipant via (matchId, participantId). Historical matches may have zero rows.
model MatchTimelineEvent {
  id            String   @id @default(uuid())
  matchId       String
  /// Stable order among preserved events for this match (0-based).
  eventIndex    Int
  type          String
  timestampMs   Int
  participantId Int?
  itemId        Int?
  beforeItemId  Int?
  afterItemId   Int?
  skillSlot     Int?
  levelUpType   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, eventIndex])
  @@index([matchId, participantId, timestampMs])
}

model ChampionMasterySnapshot {
  id                           String    @id @default(uuid())
  playerAccountId              String
  championId                   Int
  championLevel                Int
  championPoints               Int
  lastPlayTime                 DateTime? @db.Timestamptz(3)
  championPointsSinceLastLevel Int?
  championPointsUntilNextLevel Int?
  chestGranted                 Boolean?
  tokensEarned                 Int?
  capturedAt                   DateTime  @db.Timestamptz(3)
  createdAt                    DateTime  @default(now()) @db.Timestamptz(3)

  playerAccount PlayerAccount @relation(fields: [playerAccountId], references: [id], onDelete: Cascade)

  @@index([playerAccountId, capturedAt])
  @@index([playerAccountId, championId, capturedAt])
}

// ---------------------------------------------------------------------------
// Static data (patch-scoped)
// ---------------------------------------------------------------------------

model Patch {
  id                   String           @id @default(uuid())
  version              String           @unique
  normalizedMajorMinor String
  dataDragonVersion    String?
  releaseDate          DateTime?        @db.Timestamptz(3)
  isActive             Boolean          @default(false)
  staticDataStatus     StaticDataStatus @default(PENDING)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  champions      ChampionStaticData[]
  items          ItemStaticData[]
  runes          RuneStaticData[]
  summonerSpells SummonerSpellStaticData[]

  @@index([normalizedMajorMinor])
  @@index([isActive])
}

model ChampionStaticData {
  id          String   @id @default(uuid())
  patchId     String
  championId  Int
  championKey String
  name        String
  title       String
  tags        String[] @default([])
  baseStats   Json
  passive     Json
  spells      Json
  imageData   Json
  rawPayload  Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  patch Patch @relation(fields: [patchId], references: [id], onDelete: Restrict)

  @@unique([patchId, championId])
  @@unique([patchId, championKey])
  @@index([name])
}

model ItemStaticData {
  id          String   @id @default(uuid())
  patchId     String
  itemId      Int
  name        String
  description String
  plaintext   String?
  goldData     Json
  stats        Json
  tags         String[] @default([])
  imageData    Json
  purchasable  Boolean  @default(true)
  fromItemIds  Int[]    @default([])
  intoItemIds  Int[]    @default([])
  consumed     Boolean  @default(false)
  rawPayload   Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  patch Patch @relation(fields: [patchId], references: [id], onDelete: Restrict)

  @@unique([patchId, itemId])
}

model RuneStaticData {
  id               String   @id @default(uuid())
  patchId          String
  runeId           Int
  runeKey          String
  name             String
  shortDescription String?
  longDescription  String?
  icon             String
  treeId           Int?
  treeName         String?
  slotIndex        Int?
  rawPayload       Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  patch Patch @relation(fields: [patchId], references: [id], onDelete: Restrict)

  @@unique([patchId, runeId])
}

model SummonerSpellStaticData {
  id          String   @id @default(uuid())
  patchId     String
  spellId     Int
  spellKey    String
  name        String
  description String
  imageData   Json
  rawPayload  Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  patch Patch @relation(fields: [patchId], references: [id], onDelete: Restrict)

  @@unique([patchId, spellId])
}

// ---------------------------------------------------------------------------
// Aggregates (future-ready; store counts/sums, not only averages)
// Nullable dimensions use empty-string / -1 sentinels for unique constraints.
// ---------------------------------------------------------------------------

model ChampionAggregate {
  id                         String    @id @default(uuid())
  patch                      String
  /// Empty string sentinel = unspecified platform grouping.
  platformRoute              String    @default("")
  /// Empty string sentinel = unspecified regional grouping.
  regionalRoute              String    @default("")
  queueId                    Int
  rankTier                   String
  teamPosition               String
  championId                 Int
  sampleSize                 Int
  wins                       Int
  totalKills                 Int       @default(0)
  totalDeaths                Int       @default(0)
  totalAssists               Int       @default(0)
  totalCs                    Int       @default(0)
  totalGameSeconds           Int       @default(0)
  totalDamageToChampions     Int       @default(0)
  totalVisionScore           Int       @default(0)
  totalGoldEarned            Int       @default(0)
  totalGoldDifferenceAt10    Int?
  goldDifferenceAt10Samples  Int       @default(0)
  totalGoldDifferenceAt15    Int?
  goldDifferenceAt15Samples  Int       @default(0)
  totalCsDifferenceAt10      Int?
  csDifferenceAt10Samples    Int       @default(0)
  totalCsDifferenceAt15      Int?
  csDifferenceAt15Samples    Int       @default(0)
  aggregationVersion         String    @default("1")
  latestEligibleMatchAt      DateTime? @db.Timestamptz(3)
  calculatedAt               DateTime  @db.Timestamptz(3)
  sourceNormalizationVersion String

  @@unique([patch, platformRoute, regionalRoute, queueId, rankTier, teamPosition, championId, sourceNormalizationVersion, aggregationVersion])
  @@index([championId, patch, queueId, rankTier, teamPosition])
  @@index([patch, queueId, rankTier])
  @@index([platformRoute, patch, queueId, aggregationVersion])
  @@index([aggregationVersion, calculatedAt])
}

/// Per-match operational marker for champion aggregation reconcile.
/// Internal only — no PUUID, raw payload, or public DTO fields.
model ChampionAggregationProcessing {
  id                         String                              @id @default(uuid())
  matchId                    String
  sourceNormalizationVersion String
  aggregationVersion         String
  status                     ChampionAggregationProcessingStatus
  processedAt                DateTime                            @db.Timestamptz(3)
  lastErrorCode              String?
  createdAt                  DateTime                            @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                            @updatedAt @db.Timestamptz(3)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, sourceNormalizationVersion, aggregationVersion])
  @@index([status, processedAt])
}

/// Durable previous∪current key scope written at post-commit enqueue.
/// previousDimensionKeys is a JSON string[] of materialized dimension keys.
/// Explicit empty array means create / no overwrite — never treat a missing row as [].
model ChampionAggregationRecalcScope {
  id                         String   @id @default(uuid())
  matchId                    String
  sourceNormalizationVersion String
  aggregationVersion         String
  previousDimensionKeys      Json
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, sourceNormalizationVersion, aggregationVersion])
  @@index([createdAt])
}

model MatchupAggregate {
  id                         String    @id @default(uuid())
  patch                      String
  platformRoute              String    @default("")
  regionalRoute              String    @default("")
  queueId                    Int
  rankTier                   String
  teamPosition               String
  championId                 Int
  opponentChampionId         Int
  sampleSize                 Int
  wins                       Int
  totalGoldDifferenceAt10    Int?
  goldDifferenceAt10Samples  Int       @default(0)
  totalGoldDifferenceAt15    Int?
  goldDifferenceAt15Samples  Int       @default(0)
  totalCsDifferenceAt10      Int?
  csDifferenceAt10Samples    Int       @default(0)
  totalCsDifferenceAt15      Int?
  csDifferenceAt15Samples    Int       @default(0)
  soloKills                  Int?
  firstDeaths                Int?
  totalKillDifference        Int?
  totalDeathDifference       Int?
  totalAssistDifference      Int?
  aggregationVersion         String    @default("1")
  latestEligibleMatchAt      DateTime? @db.Timestamptz(3)
  calculatedAt               DateTime  @db.Timestamptz(3)
  sourceNormalizationVersion String

  @@unique([patch, platformRoute, regionalRoute, queueId, rankTier, teamPosition, championId, opponentChampionId, sourceNormalizationVersion, aggregationVersion], map: "MatchupAggregate_dims_key")
  @@index([championId, opponentChampionId, patch, queueId, rankTier])
  @@index([championId, patch, teamPosition])
}

/// Source-derived champion build/rune/spell/skill aggregates (M14).
/// One row per dimension + category + signature. Not a JSON blob of mixed builds.
model ChampionBuildAggregate {
  id                         String    @id @default(uuid())
  patch                      String
  platformRoute              String    @default("")
  regionalRoute              String    @default("")
  queueId                    Int
  rankTier                   String
  teamPosition               String
  championId                 Int
  category                   String
  signature                  String
  entityIds                  Int[]     @default([])
  auxIds                     Int[]     @default([])
  primaryStyleId             Int?
  secondaryStyleId           Int?
  sampleSize                 Int
  wins                       Int
  /// Category-level eligible participant count for this dimension (pick-rate denominator).
  eligibleGames              Int
  aggregationVersion         String    @default("1")
  latestEligibleMatchAt      DateTime? @db.Timestamptz(3)
  calculatedAt               DateTime  @db.Timestamptz(3)
  sourceNormalizationVersion String

  @@unique([patch, platformRoute, regionalRoute, queueId, rankTier, teamPosition, championId, category, signature, sourceNormalizationVersion, aggregationVersion], map: "ChampionBuildAggregate_dims_category_sig_key")
  @@index([championId, patch, queueId, rankTier, teamPosition, category], map: "ChampionBuildAggregate_champion_scope_idx")
  @@index([patch, platformRoute, queueId, aggregationVersion, category], map: "ChampionBuildAggregate_patch_platform_queue_idx")
}

/// Dedicated M16 table; do not reuse PlayerAnalysisReport.
/// No FK to ChampionStaticData (patch-scoped); insights are analytics-scoped.
model ChampionAiInsight {
  id                 String                  @id @default(uuid())
  championId         Int
  championKey        String
  patch              String
  platformRoute      String
  queueId            Int
  rankTier           String                  // public filter: ALL | exact tier
  teamPosition       String                  // ranking position
  contextFingerprint String
  promptVersion      String
  provider           String
  model              String
  status             ChampionAiInsightStatus @default(PENDING)
  inputContext       Json
  structuredResult   Json?
  failureReason      String?
  generatedAt        DateTime?               @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)

  @@unique([championId, patch, platformRoute, queueId, rankTier, teamPosition, contextFingerprint], map: "ChampionAiInsight_scope_fp_key")
  @@index([championId, patch, status])
  @@index([status, updatedAt])
}

/// Dedicated M17 table; do not reuse PlayerMetricSnapshot / PlayerAnalysisReport / AnalysisFinding.
model PlayerPlaystyleInsight {
  id                 String                       @id @default(uuid())
  playerAccountId    String
  queueId            Int
  contextFingerprint String
  promptVersion      String
  provider           String
  model              String
  status             PlayerPlaystyleInsightStatus @default(PENDING)
  inputContext       Json
  structuredResult   Json?
  failureReason      String?
  generatedAt        DateTime?                    @db.Timestamptz(3)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(3)

  playerAccount PlayerAccount @relation(fields: [playerAccountId], references: [id], onDelete: Cascade)

  @@unique([playerAccountId, queueId, contextFingerprint], map: "PlayerPlaystyleInsight_scope_fp_key")
  @@index([playerAccountId, status])
  @@index([status, updatedAt])
}

// ---------------------------------------------------------------------------
// Coaching / analysis (future)
// ---------------------------------------------------------------------------

model PlayerMetricSnapshot {
  id                         String   @id @default(uuid())
  playerAccountId            String
  selectedChampionId         Int?
  selectedOpponentChampionId Int?
  patch                      String?
  queueId                    Int?
  role                       String?
  matchesAnalyzed            Int
  sourceDataVersion          String
  /// Validated JSON metrics blob (Zod-validated at write time).
  metrics                    Json
  calculatedAt               DateTime @db.Timestamptz(3)
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)

  playerAccount PlayerAccount          @relation(fields: [playerAccountId], references: [id], onDelete: Cascade)
  reports       PlayerAnalysisReport[]

  @@index([playerAccountId, calculatedAt])
  @@index([playerAccountId, selectedChampionId, calculatedAt])
}

model PlayerAnalysisReport {
  id                     String               @id @default(uuid())
  playerAccountId        String
  playerMetricSnapshotId String
  reportType             AnalysisReportType
  status                 AnalysisReportStatus @default(PENDING)
  deterministicSummary   String?
  aiSummary              String?
  aiProvider             String?
  aiModel                String?
  sourceDataVersion      String
  generatedAt            DateTime?            @db.Timestamptz(3)
  expiresAt              DateTime?            @db.Timestamptz(3)
  failureReason          String?
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)

  playerAccount        PlayerAccount        @relation(fields: [playerAccountId], references: [id], onDelete: Cascade)
  playerMetricSnapshot PlayerMetricSnapshot @relation(fields: [playerMetricSnapshotId], references: [id], onDelete: Cascade)
  findings             AnalysisFinding[]

  @@index([playerAccountId, createdAt])
  @@index([playerMetricSnapshotId])
  @@index([status])
}

model AnalysisFinding {
  id                     String   @id @default(uuid())
  playerAnalysisReportId String
  category               String
  title                  String
  severity               String
  confidence             String
  playerValue            Float?
  peerValue              Float?
  percentile             Float?
  evidence               Json
  recommendations        Json
  sortOrder              Int
  createdAt              DateTime @default(now()) @db.Timestamptz(3)

  report PlayerAnalysisReport @relation(fields: [playerAnalysisReportId], references: [id], onDelete: Cascade)

  @@index([playerAnalysisReportId, sortOrder])
}

// ---------------------------------------------------------------------------
// Ingestion audit / idempotency (complements BullMQ; does not replace it)
// ---------------------------------------------------------------------------

model IngestionJobRecord {
  id                 String             @id @default(uuid())
  jobType            String
  idempotencyKey     String
  provider           String
  externalResourceId String?
  status             IngestionJobStatus @default(PENDING)
  priority           Int                @default(0)
  attemptCount       Int                @default(0)
  maxAttempts        Int                @default(5)
  lastErrorCode      String?
  lastErrorMessage   String?
  scheduledAt        DateTime?          @db.Timestamptz(3)
  startedAt          DateTime?          @db.Timestamptz(3)
  completedAt        DateTime?          @db.Timestamptz(3)
  deadLetteredAt     DateTime?          @db.Timestamptz(3)
  metadata           Json?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([jobType, idempotencyKey])
  @@index([status, priority, scheduledAt])
  @@index([provider, externalResourceId])
}

// ---------------------------------------------------------------------------
// Population collector (TrackedPlayer enrollment + CollectorRun audit)
// ---------------------------------------------------------------------------

model TrackedPlayer {
  id                      String                        @id @default(uuid())
  playerAccountId         String                        @unique
  provider                String
  platformRoute           String
  enrollmentSource        TrackedPlayerEnrollmentSource
  /// Explicit discovery graph depth (0 = root). Not inferred from enrollmentSource.
  discoveryDepth          Int                           @default(0)
  status                  TrackedPlayerStatus           @default(ACTIVE)
  priority                Int                           @default(0)
  nextEligibleAt          DateTime                      @db.Timestamptz(3)
  lastSuccessfulRefreshAt DateTime?                     @db.Timestamptz(3)
  lastClaimedAt           DateTime?                     @db.Timestamptz(3)
  leaseOwner              String?
  leaseExpiresAt          DateTime?                     @db.Timestamptz(3)
  consecutiveFailureCount Int                           @default(0)
  /// Successful collector runs that enqueued 0 new matches in a row (activity cold streak).
  consecutiveZeroNewMatchRuns Int                       @default(0)
  lastFailureCode         String?
  createdAt               DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                      @updatedAt @db.Timestamptz(3)

  playerAccount   PlayerAccount             @relation(fields: [playerAccountId], references: [id], onDelete: Restrict)
  runSourceQuotas CollectorRunSourceQuota[]

  @@index([status, nextEligibleAt, priority, leaseExpiresAt])
  @@index([platformRoute, status])
  /// Claim EXPLAIN preferred platform+status lead; short map avoids PG 63-char truncation drift.
  @@index([platformRoute, status, nextEligibleAt, priority, leaseExpiresAt], map: "TrackedPlayer_claim_eligibility_idx")
  @@index([leaseOwner])
  @@index([discoveryDepth])
}

model CollectorRun {
  id                                    String             @id @default(uuid())
  ownerToken                            String             @unique
  status                                CollectorRunStatus
  startedAt                             DateTime           @db.Timestamptz(3)
  finishedAt                            DateTime?          @db.Timestamptz(3)
  platformFilter                        String?
  /// JSON string array of platforms used for this run's claims
  effectivePlatforms                    Json
  queueId                               Int
  batchLimit                            Int
  concurrency                           Int
  playersClaimed                        Int                @default(0)
  playersAttempted                      Int                @default(0)
  playersSucceeded                      Int                @default(0)
  playersFailed                         Int                @default(0)
  ownershipLost                         Int                @default(0)
  matchIdsDiscovered                    Int                @default(0)
  matchesEnqueued                       Int                @default(0)
  matchesSkippedComplete                Int                @default(0)
  rateLimitStops                        Int                @default(0)
  budgetExhausted                       Boolean            @default(false)
  failureCode                           String?
  /// Task 4 async post-finalization expansion metrics (do not affect Task 3 status/equality).
  participantsConsidered                Int                @default(0)
  /// Also used as attributed create reservation counter (committed creates only).
  playersEnrolledFromParticipants       Int                @default(0)
  playersAlreadyTrackedFromParticipants Int                @default(0)
  playersSkippedDepthLimit              Int                @default(0)
  playersSkippedPopulationCap           Int                @default(0)
  createdAt                             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                             DateTime           @updatedAt @db.Timestamptz(3)

  sourceQuotas CollectorRunSourceQuota[]

  @@index([status, startedAt])
  @@index([finishedAt])
}

/// Singleton autonomous MATCH_PARTICIPANT growth budget (id = 'singleton').
model CollectorPopulationBudget {
  id                            String   @id
  matchParticipantEnrolledCount Int      @default(0)
  createdAt                     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime @updatedAt @db.Timestamptz(3)
}

/// Singleton total TrackedPlayer + LADDER-root ceilings (id = 'singleton').
/// trackedPlayerCount = ALL TrackedPlayer rows; ladderEnrolledCount = enrollmentSource=LADDER only.
/// Separate from CollectorPopulationBudget (MATCH_PARTICIPANT-only).
model CollectorTrackedPlayerBudget {
  id                  String   @id
  trackedPlayerCount  Int      @default(0)
  ladderEnrolledCount Int      @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
}

/// Singleton scheduler lease/outcome state (id = 'singleton').
model CollectorSchedulerState {
  id                 String                     @id
  leaseOwner         String?
  leaseExpiresAt     DateTime?                  @db.Timestamptz(3)
  lastTriggerAt      DateTime?                  @db.Timestamptz(3)
  lastOutcome        CollectorSchedulerOutcome?
  lastCollectorRunId String?
  lastErrorCode      String?
  cooldownUntil      DateTime?                  @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)
}

/// Ephemeral per-source-per-run expansion budget (not a discovery graph).
model CollectorRunSourceQuota {
  id                    String   @id @default(uuid())
  collectorRunId        String
  sourceTrackedPlayerId String
  newPlayersEnrolled    Int      @default(0)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  collectorRun        CollectorRun  @relation(fields: [collectorRunId], references: [id], onDelete: Cascade)
  sourceTrackedPlayer TrackedPlayer @relation(fields: [sourceTrackedPlayerId], references: [id], onDelete: Cascade)

  @@unique([collectorRunId, sourceTrackedPlayerId])
  @@index([collectorRunId])
}
