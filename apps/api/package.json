{
  "name": "@league-helper/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,prisma}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm db:test:prepare && vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "pnpm db:test:prepare && vitest run --config vitest.integration.config.mts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:test:prepare": "node ./scripts/prepare-test-db.mjs",
    "riot:resolve": "tsx src/integrations/riot/cli/riot-resolve.ts",
    "riot:match-ids": "tsx src/integrations/riot/cli/riot-match-ids.ts",
    "ddragon:champion": "tsx src/integrations/data-dragon/cli/ddragon-champion.ts",
    "champions:sync-static": "tsx src/integrations/data-dragon/cli/sync-champion-static.ts",
    "champions:sync-build-static": "tsx src/integrations/data-dragon/cli/sync-build-static.ts",
    "jobs:reconcile-match-ingestion": "tsx src/queues/cli/reconcile-match-ingestion.ts",
    "jobs:status-match-ingestion": "tsx src/queues/cli/status-match-ingestion.ts",
    "player:search:mock": "tsx src/features/players/cli/player-search-mock.ts",
    "matches:bootstrap-player": "tsx src/features/players/cli/bootstrap-player.ts",
    "matches:recompute-positions": "tsx src/features/players/cli/recompute-positions.ts",
    "collector:seed-player": "tsx src/features/collector/cli/seed-player.ts",
    "collector:ladder-seed": "tsx src/features/collector/cli/ladder-seed.ts",
    "collector:set-player-status": "tsx src/features/collector/cli/set-player-status.ts",
    "collector:run": "tsx src/features/collector/cli/run.ts",
    "collector:status": "tsx src/features/collector/cli/status.ts",
    "collector:coverage": "tsx src/features/collector/cli/coverage.ts",
    "collector:audit": "tsx src/features/collector/cli/audit.ts",
    "collector:scheduler": "tsx src/features/collector/cli/scheduler.ts",
    "collector:scheduler-status": "tsx src/features/collector/cli/scheduler-status.ts",
    "collector:scheduler-trigger": "tsx src/features/collector/cli/scheduler-trigger.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@league-helper/ai": "workspace:*",
    "@league-helper/match-analytics": "workspace:*",
    "@league-helper/server-riot": "workspace:*",
    "@league-helper/shared": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@prisma/client": "^6.5.0",
    "bullmq": "^5.81.3",
    "dotenv": "^16.4.7",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@league-helper/config": "workspace:*",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prisma": "^6.5.0",
    "tsx": "^4.23.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.26.1",
    "unplugin-swc": "^1.5.10",
    "vitest": "^3.0.8"
  }
}
